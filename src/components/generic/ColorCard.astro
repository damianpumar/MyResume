---
import { pallete } from "./colors";
import CustomCard from "./Card.astro";

interface Props {
  color?: keyof typeof pallete;
  full?: boolean;
  space?: boolean;
}

const { color = "base", full, space } = Astro.props;

const selectedColor = pallete[color];
---

<CustomCard color={selectedColor}>
  <slot />
</CustomCard>
