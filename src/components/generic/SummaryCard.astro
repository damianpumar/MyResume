---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ColorCard from "./ColorCard.astro";

export interface Props {
  title: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  description: string;
  imgPosition?: "left" | "right" | "center";
}

const { title, imgAlt, description, imgSrc, imgPosition } = Astro.props;

const classes = [];

if (imgPosition) {
  classes.push(`important-object-${imgPosition}`);
}
---

<ColorCard full space>
  <h3 class="poppins text-lg md:text-xl">
    {title}
  </h3>

  <div class="rounded-lg border-3 border-black my-4 h-56">
    <Image
      class="rounded h-full w-full object-cover object-top select-none"
      class:list={classes}
      src={imgSrc}
      alt={imgAlt}
      quality={"mid"}
      widths={[540, 720, imgSrc.width / 2]}
      sizes={`(max-width: 720px) 540px, (max-width: 1600px) 720px, ${
        imgSrc.width / 2
      }px`}
      draggable={false}
    />
  </div>
  <p class="poppins">{description}</p>
  <slot />
</ColorCard>
