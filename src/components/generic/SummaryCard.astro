---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ColorCard from "./ColorCard.astro";

export interface Props {
  title: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  description: string;
  classes?: string[];
  collapsed?: boolean;
}

const {
  title,
  imgAlt,
  description,
  imgSrc,
  classes = [],
  collapsed,
} = Astro.props;
---

<ColorCard>
  <h3 class="poppins text-lg md:text-xl">
    {title}
  </h3>

  <div
    class="rounded-lg border-3 border-black min-h-90 h-90 my-1 aspect-w-16 aspect-h-9"
  >
    <Image
      class="rounded w-full h-full select-none"
      class:list={classes}
      src={imgSrc}
      alt={imgAlt}
      quality="max"
      format="webp"
      widths={[540, 720, imgSrc.width / 2]}
      sizes={`(max-width: 720px) 540px, (max-width: 1600px) 720px, ${
        imgSrc.width / 2
      }px`}
      draggable={false}
    />
  </div>
  {
    !collapsed && (
      <div class="flex flex-col justify-between h-full mt-2 gap-4">
        <p class="poppins min-h-30">{description}</p>
        <slot />
      </div>
    )
  }
</ColorCard>
