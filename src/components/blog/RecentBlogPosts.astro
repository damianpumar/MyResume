---
import { getCollection } from "astro:content";
import BlogList from "./BlogList.astro";
import { ColorCard, Button } from "@components/generic";

interface Props {
  count?: number;
  exclude?: string[];
}

const { count, exclude } = Astro.props;

const posts = (await getCollection("blog"))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .reverse()
  .slice(0, count ?? 3)
  .filter((post) => !exclude?.includes(post.slug));
---

<section class="mt-8">
  <ColorCard color="quaternary">
    <div class="flex justify-between items-start">
      <h2 class="text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif">
        Recent Blogposts
      </h2>
      <div class="hidden md:block">
        <Button href="/blog/">Go to blog &rarr;</Button>
      </div>
      <div class="block md:hidden">
        <Button href="/blog/">All &rarr;</Button>
      </div>
    </div>
    <BlogList posts={posts} />
  </ColorCard>
</section>
