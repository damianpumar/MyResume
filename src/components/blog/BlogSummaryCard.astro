---
import type { CollectionEntry } from "astro:content";
import SummaryCard from "../generic/SummaryCard.astro";
import CustomButton from "@components/generic/CustomButton.astro";
import CustomPill from "@components/generic/CustomPill.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
---

<SummaryCard
  title={data.title}
  imgAlt={data.title}
  imgSrc={data.image}
  description={data.description}
  imgPosition={data.imagePosition}
>
  <div class="flex justify-end my-4">
    <CustomButton href={`/blog/${post.slug}/`}>Read post &rarr;</CustomButton>
  </div>

  <div class="hidden sm:inline-block">
    <p class="poppins mt-2">tags:</p>
    <div class="flex justify-between items-center">
      <ul class="inline-flex flex-wrap gap-3 mt-2">
        {
          data.tags.map((tag) => {
            return (
              <li>
                <a class="sanchez" href={`/blog/tags/${tag.toLowerCase()}/`}>
                  <CustomPill>{tag}</CustomPill>
                </a>
              </li>
            );
          })
        }
      </ul>
      {
        data.draft && (
          <span class="bg-green rounded-full border-2 py-1 px-4 text-sm border-black card-shadow">
            Draft
          </span>
        )
      }
    </div>
  </div>
</SummaryCard>
