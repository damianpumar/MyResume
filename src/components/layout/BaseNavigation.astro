---
import { socials } from "@components/home/MobileSocials.astro";
import { navigationItems, personal } from "src/configuration";

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
---

<header
  class="border-b-4 border-black flex justify-between py-6 px-2 md:px-6 items-center"
>
  {pageTitle && <h1 class="hidden">{pageTitle}</h1>}
  <a href="/" title="Home">
    <p class="righteous text-3xl md:text-4xl lg:text-5xl select-none">
      {personal.name}
    </p>
  </a>
  <nav class="hidden md:inline-block">
    <h2 class="hidden">Navigation</h2>
    <ul class="flex items-center gap-6 poppins">
      {
        navigationItems.map((item) => (
          <li>
            <a
              class="text-lg font-medium hover:text-green hover:underline transition-all duration-150 ease-in-out select-none"
              href={item.url}
              title={`Go to ${item.name}`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      {
        socials.map((item) => (
          <li>
            <a
              href={item.url}
              class="hover:text-green hover:underline transition-all duration-150 ease-in-out"
              target="_blank"
              title={`See @DamianPumar on ${item.name}`}
            >
              <div class:list={[item.icon, "w-6 h-6"]} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class="md:hidden flex">
    <h2 class="hidden">Mobile Navigation</h2>
    <ul class="flex flex-row gap-4 text-xl">
      {
        navigationItems
          .filter((n) => n.mobile)
          .map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>
            </li>
          ))
      }
    </ul>
  </nav>
</header>
