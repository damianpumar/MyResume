---
import { personal } from "src/configuration";

interface Props {
  content: any;
  back: {
    href: string;
  };
  published?: boolean;
}

const { content, back, published = false } = Astro.props;
const { title, author } = content;

const date = new Date(content.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="prose-slate w-sm md:w-prose md:prose poppins">
  <a href={`/${back.href}`} title={`Back to ${title}`}>&larr; Back to {title}</a
  >
  {
    published && (
      <p class="text-slate text-sm md:text-base">
        Published on {date} by {author}
      </p>
    )
  }
  <slot />
  <p class="text-slate">Written by {content.author}</p>
  <p>
    Something wrong? <a
      href=`mailto:${personal.email}?subject=Feedback about ${title}`
      >Let me know</a
    > 🙏
  </p>
  <a href={`/${back.href}`} title={`Back to ${title}`}>&larr; Back to {title}</a
  >
</article>
