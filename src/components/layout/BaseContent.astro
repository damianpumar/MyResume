---
import { personal } from "src/configuration";

interface Props {
  content: any;
  file: string;
}

const { content, file } = Astro.props;
const { title, author } = content;

const showPublished = !!content.date;
const splitted = file.split("/");
const back = splitted[splitted.length - 2];

const date = new Date(content.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="prose-slate w-sm md:w-prose md:prose poppins">
  <a href={`/${back}`}>&larr; Back to {back}</a>
  {
    showPublished && (
      <p class="text-slate text-sm md:text-base">
        Published on {date} {author && `by ${author}`}
      </p>
    )
  }
  <slot />
  {content.author && <p class="text-slate">Written by {content.author}</p>}
  <p class="mt-20">
    Something wrong? <a
      href=`mailto:${personal.email}?subject=Feedback about ${title}`
      >Let me know</a
    > 🙏
  </p>
  <a href={`/${back}`}>&larr; Back to {back}</a>
</article>
