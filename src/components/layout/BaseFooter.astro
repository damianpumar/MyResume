---
import { navigationItems } from "src/configuration";

const commitVersion = import.meta.env.RELEASE_VERSION
---

<footer class='bg-black sanchez p-6 flex flex-row justify-between'>
  <h2 class='hidden'>Footer</h2>
  <div class="text-white">
    |
    {navigationItems.map((item) => (
          <a class='text-blue'
            href={item.url}
            target={'_self'}
            title={`Go to ${item.name}`} >
            {item.name}
          </a>
          <span>|</span>
      ))}
      {new Date().getFullYear()} |
  </div>
  <div class="text-gray">
    {commitVersion}
  </div>
</footer>
