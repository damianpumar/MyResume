---
import { navigationItems } from "src/configuration";
---

<footer class="bg-black poppins px-2 py-6 md-p-6 flex flex-row justify-between">
  <h2 class="hidden">Footer</h2>
  <div class="text-white flex flex-row justify-between w-full md-w-md">
    <span>|</span>
    {
      navigationItems.map((item) => (
        <>
          <a
            class="text-blue"
            href={item.url}
            target={"_self"}
            title={`Go to ${item.name}`}
          >
            {item.name}
          </a>
          <span>|</span>
        </>
      ))
    }
    {new Date().getFullYear()}
    <span>|</span>
  </div>
</footer>
