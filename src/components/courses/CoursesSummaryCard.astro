---
import type { CollectionEntry } from "astro:content";
import { SummaryCard, Button } from "@components/generic";

interface Props {
  course: CollectionEntry<"courses">;
}

const { course } = Astro.props;
const { data } = course;
---

<SummaryCard
  title={data.title}
  imgAlt={data.title}
  imgSrc={data.image}
  description={data.description}
>
  <div class="flex justify-end my-4">
    <Button href={`/courses/${course.slug}/`}>Go to course &rarr;</Button>
  </div>
</SummaryCard>
