---
import type { CollectionEntry } from "astro:content";
import { SummaryCard, Button, Pill } from "@components/generic";

interface Props {
  course: CollectionEntry<"courses">;
}

const { course } = Astro.props;
const { data } = course;
---

<SummaryCard
  title={data.title}
  imgAlt={data.title}
  imgSrc={data.image}
  description={data.description}
  imgPosition={data.imagePosition}
>
  <div class="flex justify-end my-4">
    <Button href={`/courses/${course.slug}/`}>Go to course &rarr;</Button>
  </div>

  <div class="hidden sm:inline-block">
    <p class="poppins mt-2">tags:</p>
    <div class="flex justify-between items-center">
      <ul class="inline-flex flex-wrap gap-3 mt-2">
        {
          data.tags.map((tag) => {
            return (
              <li>
                <a class="sanchez" href={`/blog/tags/${tag.toLowerCase()}/`}>
                  <Pill>{tag}</Pill>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</SummaryCard>
