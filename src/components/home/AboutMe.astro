---
import ColorCard from "@components/generic/ColorCard.astro";
import CustomButton from "@components/generic/CustomButton.astro";
import { Image } from "astro:assets";
import { personal } from "src/configuration";
---

<section id="about" class="grid md:grid-cols-6 xl:grid-cols-8 gap-8 mt-4">
  <h2 class="hidden">About {personal.name}</h2>
  <div class="flex flex-col md:col-span-4 xl:col-span-6">
    <ColorCard color="primary">
      <p class="mt-4 outfit text-2xl md:text-5xl lg:text-7xl">
        {personal.work[0].name}
        <a
          class="underline underline-blue"
          href={personal.work[0].web}
          target="_blank">{personal.work[0].at}</a
        >
      </p>
      {
        personal.work.slice(1).map((work) => (
          <p class="sanchez mt-4 mb-8 text-md md:text-lg lg:text-2xl">
            {work.name}{" "}
            <a class="underline underline-blue" href={work.web} target="_blank">
              {work.at}
            </a>
          </p>
        ))
      }
      {
        personal.titles.map((bio) => (
          <p class="mt-4 outfit text-xl md:text-xl lg:text-2xl">{bio}</p>
        ))
      }
      <p
        class="sanchez mt-4 mb-4 text-lg md:text-xl lg:text-2xl flex flex-row gap-lg"
      >
        I live in {personal.live.where}
        {personal.live.image}, I was born in {personal.born.where}
        {personal.born.image}
      </p>

      <!-- <CustomButton target={'_self'} href='/blog/'>
          Check out the blog &rarr;
        </CustomButton> -->

      <CustomButton target={"_self"} href="/events/">
        Check out the events &rarr;
      </CustomButton>
    </ColorCard>
  </div>
  <div class="md:col-span-2 card-shadow">
    <Image
      class="object-cover object-top aspect-1 md-aspect-2 h-full w-full rounded"
      src={personal.profile}
      alt={personal.name}
      widths={[540, 720, personal.profile.width]}
      sizes={`(max-width: 720px) 540px, (max-width: 1600px) 720px, ${personal.profile.width}px`}
      draggable={false}
      loading={"eager"}
    />
  </div>
</section>
