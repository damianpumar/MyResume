---
import { Card, Pill } from "@eliancodes/brutal-ui";
import { Fragment } from "astro/dist/runtime/server";
import { personal } from "src/configuration";


---

<section class="mt-8 grid md:grid-cols-2 gap-8">
	<Card>
		<h2 class="text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif">
			What's keeping me busy?
		</h2>
		<ul class="flex gap-4 flex-wrap">
			{
				personal.doing.map((item) => (
					<li class="sanchez">
						<Pill>
							<a href={item.url} target="_blank" title={`Go to ${item.name}`}>
								{item.name}
							</a>
						</Pill>
					</li>
				))
			}
		</ul>
	</Card>
	<Card>
		<h2 class="text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif">Who am I?</h2>
		<p class="poppins"set:html={personal.bio.first} />
		<p class="poppins mt-2" set:html={personal.bio.second} />
		<p class="poppins mt-2" set:html={personal.bio.third} />
		</p>
	</Card>
</section>