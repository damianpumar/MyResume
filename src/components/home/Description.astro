---
import { getCollection } from "astro:content";
import Bio from "./components/Bio.astro";
import Hobbies from "./components/Hobbies.astro";
import NextTalk from "./components/NextTalk.astro";

const now = new Date();
const events = (await getCollection("events"))
  .filter((e) => e.data.date > now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 1);

const hasEvents = events.length > 0;
---

<section class={`lt-lg-hidden mt-8 grid grid-flow-col auto-cols-auto gap-8`}>
  <Bio />

  <Hobbies />

  {hasEvents && <NextTalk />}
</section>

<section class="lg-hidden mt-8 grid grid-cols-1 gap-8">
  <div class="grid grid-cols-1">
    <Bio />
  </div>

  <div class={`grid sm:grid-cols-${hasEvents ? "2" : "1"} gap-8`}>
    <Hobbies />

    {hasEvents && <NextTalk />}
  </div>
</section>
