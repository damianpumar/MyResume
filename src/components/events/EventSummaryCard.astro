---
import { Button, Pill, SummaryCard } from "@components/generic";
import type { CollectionEntry } from "astro:content";

export interface Props {
  event: CollectionEntry<"events">;
  collapsed?: boolean;
}

const { event, collapsed = false } = Astro.props;
const { data } = event;
const comingSoon = data.date > new Date();
---

<SummaryCard
  title={data.title}
  imgSrc={data.image}
  imgAlt={data.title}
  description={data.description}
  classes={data.classes}
  collapsed={collapsed}
>
  <div class="flex flex-col justify-between">
    <p>
      <a
        target="_blank"
        href={data.link}
        title={data.title}
        class="hover:text-yellow transition-color duration-150 ease-in-out select-none"
        >{data.name}</a
      > - {
        data.date.toLocaleDateString("en", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </p>
    <div class="md:flex justify-between flex-items-center gap-4 hidden mt-2">
      <div>
        {comingSoon && <Pill>Coming soon</Pill>}
      </div>
      {
        data.link && (
          <Button target="_blank" href={data.link}>
            See event
          </Button>
        )
      }
    </div>
  </div>
</SummaryCard>
