---
import { Button, Pill, SummaryCard } from "@components/generic";
import type { CollectionEntry } from "astro:content";

export interface Props {
  event: CollectionEntry<"events">;
}

const { event, collapsed } = Astro.props;
const { data } = event;
const comingSoon = data.date > new Date();
---

<SummaryCard
  title={data.title}
  imgSrc={data.image}
  imgAlt={data.title}
  description={data.description}
  imgPosition={data.imagePosition}
  collapsed={collapsed}
>
  <p class="mt-2">
    <a
      target="_blank"
      href={data.link}
      title={data.title}
      class="hover:text-yellow transition-color duration-150 ease-in-out select-none"
      >{data.name}</a
    > - {
      data.date.toLocaleDateString("en-BE", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    }
  </p>
  <div class="md:flex justify-between flex-items-center gap-4 mt-4 hidden">
    <div>
      {comingSoon && <Pill>Coming soon</Pill>}
    </div>
    {
      data.link && (
        <Button target="_blank" href={data.link}>
          See event
        </Button>
      )
    }
  </div>
</SummaryCard>
