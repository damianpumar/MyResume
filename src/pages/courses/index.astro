---
import CourseList from "@components/courses/CourseList.astro";
import Layout from "@layouts/Default.astro";
import { getCollection } from "astro:content";
import { personal } from "src/configuration";

const courses = await getCollection("courses").then((events) =>
  events.sort((a, b) => a.data.order - b.data.order)
);
---

<Layout
  title="Courses"
  pageTitle={`${personal.name} - Courses`}
  description="My courses"
>
  <main class="bg-lightblue p-6">
    <CourseList courses={courses} />
  </main>
</Layout>
